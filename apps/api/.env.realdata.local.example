# Copiar a .env.realdata.local y completar SOLO estas cuatro claves.
# Neon > valorar-db > dev-valorar-realdata > Connect > neondb > Direct connection.
# No usar el pooler; endpoint esperado ep-orange-resonance-acqkorp6.sa-east-1.aws.neon.tech.
DATABASE_URL=
# IDs del panel Neon, no nombres. Nunca usar los IDs de production o rental-management-dev.
REALDATA_NEON_PROJECT_ID=
REALDATA_NEON_BRANCH_ID=
# Secret exclusivo local, aleatorio, de al menos 32 caracteres. No reutilizar producción.
JWT_SECRET=
