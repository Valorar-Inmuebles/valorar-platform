// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id   String @id @default(cuid())
  name String
  slug String @unique

  status TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                      User[]
  settings                   TenantSetting?
  properties                 Property[]
  propertyListings           PropertyListing[]
  propertyPrices             PropertyPrice[]
  propertyImages             PropertyImage[]
  propertyFeatureAssignments PropertyFeatureAssignment[]
  propertyAgentAccess        PropertyAgentAccess[]
  developments               Development[]
  developmentImages          DevelopmentImage[]
  developmentFeatureAssignments DevelopmentFeatureAssignment[]
  developmentTypologies      DevelopmentTypology[]
  developmentTypologyFeatureAssignments DevelopmentTypologyFeatureAssignment[]
  migrationSourceRefs        MigrationSourceRef[]
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  AGENT
  COLLABORATOR
}

model User {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  firstName String
  lastName  String
  name      String
  email     String @unique
  phone     String?
  avatarUrl String?

  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  role UserRole @default(AGENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProperties      Property[]            @relation("PropertyCreator")
  assignedProperties     Property[]            @relation("PropertyAssignee")
  sharedPropertyAccess   PropertyAgentAccess[] @relation("PropertySharedWith")
  grantedPropertyAccess  PropertyAgentAccess[] @relation("PropertyAccessGrantedBy")
  createdDevelopments    Development[]         @relation("DevelopmentCreator")

  @@index([tenantId])
}

model TenantSetting {
  id String @id @default(cuid())

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyName String?
  legalName   String?

  logoUrl String?

  primaryColor   String?
  secondaryColor String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?
  address  String?

  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?

  shortDescription String? @db.Text
  seoTitle         String?
  seoDescription   String? @db.Text

  domain String?

  propertyVisibilityPolicy PropertyVisibilityPolicy @default(AGENT_OWN_ONLY)
  propertyEditPolicy       PropertyEditPolicy       @default(CREATOR_OR_ASSIGNEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PropertyVisibilityPolicy {
  AGENT_OWN_ONLY
  AGENT_SEE_ALL
}

enum PropertyEditPolicy {
  CREATOR_ONLY
  CREATOR_OR_ASSIGNEE
}

enum PropertyType {
  HOUSE
  APARTMENT
  PH
  OFFICE
  COMMERCIAL
  WAREHOUSE
  INDUSTRIAL
  LAND
  FIELD
  GARAGE
  COUNTRY_HOUSE
  OTHER
}

enum PropertyCondition {
  NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  REGULAR
  TO_RENOVATE
  UNDER_CONSTRUCTION
}

enum PropertyListingType {
  SALE
  RENT
  TEMPORARY_RENT
}

enum PropertyListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  CLOSED
}

enum Currency {
  ARS
  USD
}

enum PropertyFeatureCategory {
  GENERAL
  SERVICE
  ROOM
  AMENITY
}

enum Orientation {
  NORTH
  SOUTH
  EAST
  WEST
  NORTHEAST
  NORTHWEST
  SOUTHEAST
  SOUTHWEST
}

enum PropertyLayout {
  FRONT
  BACK
  SIDE
  INTERNAL
  CORNER
}

enum PropertyBrightness {
  LOW
  MEDIUM
  HIGH
}

enum GeocodeSource {
  MANUAL
  GOOGLE_PLACES
  IMPORT
}

enum GeocodeAccuracy {
  EXACT
  APPROXIMATE
  NEIGHBORHOOD
  CITY
}

model Property {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PropertyCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("PropertyAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  slug         String
  internalCode String?
  title        String
  description  String? @db.Text

  propertyType PropertyType
  condition    PropertyCondition?

  isActive Boolean @default(true)

  street       String?
  streetNumber String?
  floor        String?
  apartment    String?
  neighborhood String?
  city         String
  province     String?
  country      String  @default("AR")
  countryId      String?
  provinceId     String?
  localityId     String?
  neighborhoodId String?
  geoCountry     Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoProvince    Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  geoLocality    Locality?     @relation(fields: [localityId], references: [id], onDelete: SetNull)
  geoNeighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  googlePlaceId      String?
  formattedAddress   String?
  geocodeSource      GeocodeSource?
  geocodeAccuracy    GeocodeAccuracy?

  totalArea     Decimal? @db.Decimal(10, 2)
  coveredArea   Decimal? @db.Decimal(10, 2)
  uncoveredArea Decimal? @db.Decimal(10, 2)
  lotFront      Decimal? @db.Decimal(10, 2)
  lotDepth      Decimal? @db.Decimal(10, 2)

  rooms         Int?
  bedrooms      Int?
  bathrooms     Int?
  halfBathrooms Int?
  parkingSpaces Int?

  yearBuilt   Int?
  orientation Orientation?
  layout      PropertyLayout?
  brightness  PropertyBrightness?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings           PropertyListing[]
  images             PropertyImage[]
  featureAssignments PropertyFeatureAssignment[]
  agentAccess        PropertyAgentAccess[]

  @@unique([tenantId, slug])
  @@unique([tenantId, internalCode])
  @@index([tenantId])
  @@index([tenantId, createdById])
  @@index([tenantId, assignedToId])
  @@index([tenantId, city])
  @@index([tenantId, province])
  @@index([tenantId, provinceId])
  @@index([tenantId, localityId])
  @@index([countryId])
  @@index([provinceId])
  @@index([localityId])
  @@index([neighborhoodId])
  @@index([tenantId, propertyType])
  @@index([tenantId, condition])
  @@index([tenantId, updatedAt])
}

model PropertyListing {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingType PropertyListingType
  status      PropertyListingStatus @default(DRAFT)

  expensesAmount   Decimal?  @db.Decimal(12, 2)
  expensesCurrency Currency?
  isFeatured       Boolean   @default(false)

  publishedAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices PropertyPrice[]

  @@unique([propertyId, listingType])
  @@index([tenantId])
  @@index([tenantId, listingType, status])
  @@index([tenantId, isFeatured])
}

model PropertyPrice {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amount   Decimal  @db.Decimal(14, 2)
  currency Currency

  isPrimary Boolean @default(false)
  label     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([listingId])
}

model PropertyImage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  storageKey String
  url        String?
  altText    String?
  mimeType   String?
  fileSize   Int?

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId, sortOrder])
}

model PropertyFeature {
  id String @id @default(cuid())

  name     String
  slug     String @unique
  category PropertyFeatureCategory

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments PropertyFeatureAssignment[]
  developmentAssignments DevelopmentFeatureAssignment[]
  typologyAssignments DevelopmentTypologyFeatureAssignment[]

  @@index([category])
}

model PropertyFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, featureId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([featureId])
}

model PropertyAgentAccess {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PropertySharedWith", fields: [userId], references: [id], onDelete: Cascade)

  canView Boolean @default(true)
  canEdit Boolean @default(false)

  grantedById String?
  grantedBy   User?   @relation("PropertyAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Country {
  id        String     @id @default(cuid())
  name      String
  iso2      String     @unique
  slug      String     @unique
  search    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  provinces  Province[]
  properties Property[]
  developments Development[]

  @@index([search])
}

model Province {
  id         String     @id @default(cuid())
  countryId  String
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name       String
  isoCode    String?
  slug       String
  search     String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  localities Locality[]
  properties Property[]
  developments Development[]

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([search])
}

model Locality {
  id            String         @id @default(cuid())
  provinceId    String
  province      Province       @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  name          String
  postalCode    String?
  slug          String
  search        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  neighborhoods Neighborhood[]
  properties    Property[]
  developments  Development[]

  @@unique([provinceId, name])
  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([search])
}

model Neighborhood {
  id         String   @id @default(cuid())
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id], onDelete: Restrict)
  name       String
  slug       String
  search     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  properties Property[]
  developments Development[]

  @@unique([localityId, name])
  @@unique([localityId, slug])
  @@index([localityId])
  @@index([search])
}

enum DevelopmentStatus {
  IN_PIT
  UNDER_CONSTRUCTION
  COMPLETED
}

model Development {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("DevelopmentCreator", fields: [createdById], references: [id])

  slug         String
  internalCode String?
  title        String
  shortDescription String @db.Text
  description  String  @db.Text
  status       DevelopmentStatus?

  isActive Boolean @default(true)

  street       String?
  streetNumber String?
  neighborhood String?
  city         String
  province     String?
  country      String  @default("AR")
  countryId      String?
  provinceId     String?
  localityId     String?
  neighborhoodId String?
  geoCountry     Country?      @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoProvince    Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  geoLocality    Locality?     @relation(fields: [localityId], references: [id], onDelete: SetNull)
  geoNeighborhood Neighborhood? @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  googlePlaceId      String?
  formattedAddress   String?
  geocodeSource      GeocodeSource?
  geocodeAccuracy    GeocodeAccuracy?

  priceFrom            Decimal?  @db.Decimal(14, 2)
  currency             Currency?
  hasFinancing         Boolean   @default(false)
  financingDescription String?   @db.Text

  hasParkingSpaces   Boolean @default(false)
  parkingSpacesCount Int?

  /// Editorial list order. Lower values appear first.
  /// Default 0 keeps ABM-created developments above the imported historical batch (1..n).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             DevelopmentImage[]
  featureAssignments DevelopmentFeatureAssignment[]
  typologies         DevelopmentTypology[]

  @@unique([tenantId, slug])
  @@unique([tenantId, internalCode])
  @@index([tenantId])
  @@index([tenantId, createdById])
  @@index([tenantId, city])
  @@index([tenantId, province])
  @@index([tenantId, provinceId])
  @@index([tenantId, localityId])
  @@index([countryId])
  @@index([provinceId])
  @@index([localityId])
  @@index([neighborhoodId])
  @@index([tenantId, status])
  @@index([tenantId, sortOrder])
  @@index([tenantId, updatedAt])
}

model DevelopmentImage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  storageKey String
  url        String?
  altText    String?
  mimeType   String?
  fileSize   Int?

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([developmentId, sortOrder])
}

model DevelopmentFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([developmentId, featureId])
  @@index([tenantId])
  @@index([developmentId])
  @@index([featureId])
}

model DevelopmentTypology {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  name        String
  description String  @db.Text
  totalCount       Int?
  availableCount   Int?
  surfaceFrom      Decimal? @db.Decimal(10, 2)
  surfaceTo        Decimal? @db.Decimal(10, 2)
  priceFrom        Decimal? @db.Decimal(14, 2)
  currency         Currency?
  sortOrder        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  featureAssignments DevelopmentTypologyFeatureAssignment[]

  @@index([tenantId])
  @@index([developmentId, sortOrder])
}

model DevelopmentTypologyFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  typologyId String
  typology   DevelopmentTypology @relation(fields: [typologyId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typologyId, featureId])
  @@index([tenantId])
  @@index([typologyId])
  @@index([featureId])
}

/// Traceability for external imports (e.g. WordPress/Houzez).
/// entityId is NOT a polymorphic FK — PostgreSQL cannot enforce FKs across
/// Property | PropertyListing | PropertyPrice | PropertyImage | … via one column.
/// Referential integrity is application-owned; cascade deletes only apply to Tenant.
model MigrationSourceRef {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Logical entity kind, e.g. property | property_listing | property_price | property_image | property_feature_assignment | batch_manifest
  entityType String

  /// Target row id (cuid) in the corresponding table — not FK-enforced
  entityId String

  sourceSystem String
  sourceId     String

  migrationBatchId String

  /// Free-form migration metadata (oldSlug, oldUrl, rulesApplied, createdEntityIds, …)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sourceSystem, sourceId, entityType])
  @@index([migrationBatchId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, sourceSystem, migrationBatchId])
}
