// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model Tenant {
  id   String @id @default(cuid())
  name String
  slug String @unique

  status TenantStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                                 User[]
  settings                              TenantSetting?
  properties                            Property[]
  propertyListings                      PropertyListing[]
  propertyPrices                        PropertyPrice[]
  propertyImages                        PropertyImage[]
  propertyFeatureAssignments            PropertyFeatureAssignment[]
  propertyAgentAccess                   PropertyAgentAccess[]
  developments                          Development[]
  developmentImages                     DevelopmentImage[]
  developmentFeatureAssignments         DevelopmentFeatureAssignment[]
  developmentTypologies                 DevelopmentTypology[]
  developmentTypologyFeatureAssignments DevelopmentTypologyFeatureAssignment[]
  migrationSourceRefs                   MigrationSourceRef[]
  contacts                              Contact[]
  contactPoints                         ContactPoint[]
  rentalConcepts                        RentalConcept[]
  rentalContracts                       RentalContract[]
  rentalContractSequence                RentalContractSequence?
  rentalContractParties                 RentalContractParty[]
  rentalContractNotificationRoutes      RentalContractNotificationRoute[]
  rentalObligations                     RentalObligation[]
  rentalRentValueRevisions              RentalRentValueRevision[]
  rentalObligationOccurrences           RentalObligationOccurrence[]
  rentalFulfillments                    RentalFulfillment[]
  rentalContractEvents                  RentalContractEvent[]
  rentalReminderPolicy                  RentalReminderPolicy?
  rentalReminderPlanningIssues          RentalReminderPlanningIssue[]
  rentalReminderDispatches              RentalReminderDispatch[]
  rentalReminderDispatchOccurrences     RentalReminderDispatchOccurrence[]
  rentalReminderDeliveries              RentalReminderDelivery[]
  rentalReminderDeliveryAttempts        RentalReminderDeliveryAttempt[]
  rentalReminderWebhookReceipts         RentalReminderWebhookReceipt[]
  communicationInboundMessages          CommunicationInboundMessage[]
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  AGENT
  COLLABORATOR
}

model User {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  firstName String
  lastName  String
  name      String
  email     String  @unique
  phone     String?
  avatarUrl String?

  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?

  role UserRole @default(AGENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdProperties          Property[]                   @relation("PropertyCreator")
  assignedProperties         Property[]                   @relation("PropertyAssignee")
  sharedPropertyAccess       PropertyAgentAccess[]        @relation("PropertySharedWith")
  grantedPropertyAccess      PropertyAgentAccess[]        @relation("PropertyAccessGrantedBy")
  createdDevelopments        Development[]                @relation("DevelopmentCreator")
  createdRentalContracts     RentalContract[]             @relation("RentalContractCreator")
  recordedRentalFulfillments RentalFulfillment[]          @relation("RentalFulfillmentRecorder")
  reversedRentalFulfillments RentalFulfillment[]          @relation("RentalFulfillmentReverser")
  cancelledRentalOccurrences RentalObligationOccurrence[] @relation("RentalOccurrenceCanceller")
  recordedRentValueRevisions RentalRentValueRevision[]    @relation("RentalRentValueRevisionRecorder")
  rentalContractEvents       RentalContractEvent[]        @relation("RentalContractEventActor")

  @@index([tenantId])
}

model TenantSetting {
  id String @id @default(cuid())

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  companyName String?
  legalName   String?

  logoUrl String?

  primaryColor   String?
  secondaryColor String?

  phone    String?
  whatsapp String?
  email    String?
  website  String?
  address  String?

  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?

  shortDescription String? @db.Text
  seoTitle         String?
  seoDescription   String? @db.Text

  domain String?

  propertyVisibilityPolicy PropertyVisibilityPolicy @default(AGENT_OWN_ONLY)
  propertyEditPolicy       PropertyEditPolicy       @default(CREATOR_OR_ASSIGNEE)

  timeZone String @default("America/Argentina/Buenos_Aires")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PropertyVisibilityPolicy {
  AGENT_OWN_ONLY
  AGENT_SEE_ALL
}

enum PropertyEditPolicy {
  CREATOR_ONLY
  CREATOR_OR_ASSIGNEE
}

enum PropertyType {
  HOUSE
  APARTMENT
  PH
  OFFICE
  COMMERCIAL
  WAREHOUSE
  INDUSTRIAL
  LAND
  FIELD
  GARAGE
  COUNTRY_HOUSE
  OTHER
}

enum PropertyCondition {
  NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  REGULAR
  TO_RENOVATE
  UNDER_CONSTRUCTION
}

enum PropertyListingType {
  SALE
  RENT
  TEMPORARY_RENT
}

enum PropertyListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  RESERVED
  CLOSED
}

enum Currency {
  ARS
  USD
}

enum PropertyFeatureCategory {
  GENERAL
  SERVICE
  ROOM
  AMENITY
}

enum Orientation {
  NORTH
  SOUTH
  EAST
  WEST
  NORTHEAST
  NORTHWEST
  SOUTHEAST
  SOUTHWEST
}

enum PropertyLayout {
  FRONT
  BACK
  SIDE
  INTERNAL
  CORNER
}

enum PropertyBrightness {
  LOW
  MEDIUM
  HIGH
}

enum GeocodeSource {
  MANUAL
  GOOGLE_PLACES
  IMPORT
}

enum GeocodeAccuracy {
  EXACT
  APPROXIMATE
  NEIGHBORHOOD
  CITY
}

model Property {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PropertyCreator", fields: [createdById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("PropertyAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  slug         String
  internalCode String?
  title        String
  description  String? @db.Text

  propertyType PropertyType
  condition    PropertyCondition?

  isActive Boolean @default(true)

  street           String?
  streetNumber     String?
  floor            String?
  apartment        String?
  neighborhood     String?
  city             String
  province         String?
  country          String           @default("AR")
  countryId        String?
  provinceId       String?
  localityId       String?
  neighborhoodId   String?
  geoCountry       Country?         @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoProvince      Province?        @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  geoLocality      Locality?        @relation(fields: [localityId], references: [id], onDelete: SetNull)
  geoNeighborhood  Neighborhood?    @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  postalCode       String?
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  googlePlaceId    String?
  formattedAddress String?
  geocodeSource    GeocodeSource?
  geocodeAccuracy  GeocodeAccuracy?

  totalArea     Decimal? @db.Decimal(10, 2)
  coveredArea   Decimal? @db.Decimal(10, 2)
  uncoveredArea Decimal? @db.Decimal(10, 2)
  lotFront      Decimal? @db.Decimal(10, 2)
  lotDepth      Decimal? @db.Decimal(10, 2)

  rooms         Int?
  bedrooms      Int?
  bathrooms     Int?
  halfBathrooms Int?
  parkingSpaces Int?

  yearBuilt   Int?
  orientation Orientation?
  layout      PropertyLayout?
  brightness  PropertyBrightness?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listings           PropertyListing[]
  images             PropertyImage[]
  featureAssignments PropertyFeatureAssignment[]
  agentAccess        PropertyAgentAccess[]
  rentalContracts    RentalContract[]

  @@unique([tenantId, slug])
  @@unique([tenantId, internalCode])
  @@index([tenantId])
  @@index([tenantId, createdById])
  @@index([tenantId, assignedToId])
  @@index([tenantId, city])
  @@index([tenantId, province])
  @@index([tenantId, provinceId])
  @@index([tenantId, localityId])
  @@index([countryId])
  @@index([provinceId])
  @@index([localityId])
  @@index([neighborhoodId])
  @@index([tenantId, propertyType])
  @@index([tenantId, condition])
  @@index([tenantId, updatedAt])
}

model PropertyListing {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  listingType PropertyListingType
  status      PropertyListingStatus @default(DRAFT)

  expensesAmount   Decimal?  @db.Decimal(12, 2)
  expensesCurrency Currency?
  isFeatured       Boolean   @default(false)

  publishedAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prices PropertyPrice[]

  @@unique([propertyId, listingType])
  @@index([tenantId])
  @@index([tenantId, listingType, status])
  @@index([tenantId, isFeatured])
}

model PropertyPrice {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  listingId String
  listing   PropertyListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  amount   Decimal  @db.Decimal(14, 2)
  currency Currency

  isPrimary Boolean @default(false)
  label     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([listingId])
}

model PropertyImage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  storageKey String
  url        String?
  altText    String?
  mimeType   String?
  fileSize   Int?

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([propertyId, sortOrder])
}

model PropertyFeature {
  id String @id @default(cuid())

  name     String
  slug     String                  @unique
  category PropertyFeatureCategory

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments            PropertyFeatureAssignment[]
  developmentAssignments DevelopmentFeatureAssignment[]
  typologyAssignments    DevelopmentTypologyFeatureAssignment[]

  @@index([category])
}

model PropertyFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, featureId])
  @@index([tenantId])
  @@index([propertyId])
  @@index([featureId])
}

model PropertyAgentAccess {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PropertySharedWith", fields: [userId], references: [id], onDelete: Cascade)

  canView Boolean @default(true)
  canEdit Boolean @default(false)

  grantedById String?
  grantedBy   User?   @relation("PropertyAccessGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([propertyId, userId])
  @@index([tenantId])
  @@index([userId])
}

model Country {
  id              String           @id @default(cuid())
  name            String
  iso2            String           @unique
  slug            String           @unique
  search          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  provinces       Province[]
  properties      Property[]
  developments    Development[]
  rentalContracts RentalContract[] @relation("RentalContractCountry")

  @@index([search])
}

model Province {
  id              String           @id @default(cuid())
  countryId       String
  country         Country          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  name            String
  isoCode         String?
  slug            String
  search          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  localities      Locality[]
  properties      Property[]
  developments    Development[]
  rentalContracts RentalContract[] @relation("RentalContractProvince")

  @@unique([countryId, name])
  @@unique([countryId, slug])
  @@index([countryId])
  @@index([search])
}

model Locality {
  id              String           @id @default(cuid())
  provinceId      String
  province        Province         @relation(fields: [provinceId], references: [id], onDelete: Restrict)
  name            String
  postalCode      String?
  slug            String
  search          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  neighborhoods   Neighborhood[]
  properties      Property[]
  developments    Development[]
  rentalContracts RentalContract[] @relation("RentalContractLocality")

  @@unique([provinceId, name])
  @@unique([provinceId, slug])
  @@index([provinceId])
  @@index([search])
}

model Neighborhood {
  id              String           @id @default(cuid())
  localityId      String
  locality        Locality         @relation(fields: [localityId], references: [id], onDelete: Restrict)
  name            String
  slug            String
  search          String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  properties      Property[]
  developments    Development[]
  rentalContracts RentalContract[] @relation("RentalContractNeighborhood")

  @@unique([localityId, name])
  @@unique([localityId, slug])
  @@index([localityId])
  @@index([search])
}

enum DevelopmentStatus {
  IN_PIT
  UNDER_CONSTRUCTION
  COMPLETED
}

model Development {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("DevelopmentCreator", fields: [createdById], references: [id])

  slug             String
  internalCode     String?
  title            String
  shortDescription String             @db.Text
  description      String             @db.Text
  status           DevelopmentStatus?

  isActive Boolean @default(true)

  street           String?
  streetNumber     String?
  neighborhood     String?
  city             String
  province         String?
  country          String           @default("AR")
  countryId        String?
  provinceId       String?
  localityId       String?
  neighborhoodId   String?
  geoCountry       Country?         @relation(fields: [countryId], references: [id], onDelete: SetNull)
  geoProvince      Province?        @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  geoLocality      Locality?        @relation(fields: [localityId], references: [id], onDelete: SetNull)
  geoNeighborhood  Neighborhood?    @relation(fields: [neighborhoodId], references: [id], onDelete: SetNull)
  postalCode       String?
  latitude         Decimal?         @db.Decimal(10, 7)
  longitude        Decimal?         @db.Decimal(10, 7)
  googlePlaceId    String?
  formattedAddress String?
  geocodeSource    GeocodeSource?
  geocodeAccuracy  GeocodeAccuracy?

  priceFrom            Decimal?  @db.Decimal(14, 2)
  currency             Currency?
  hasFinancing         Boolean   @default(false)
  financingDescription String?   @db.Text

  hasParkingSpaces   Boolean @default(false)
  parkingSpacesCount Int?

  /// Editorial list order. Lower values appear first.
  /// Default 0 keeps ABM-created developments above the imported historical batch (1..n).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images             DevelopmentImage[]
  featureAssignments DevelopmentFeatureAssignment[]
  typologies         DevelopmentTypology[]

  @@unique([tenantId, slug])
  @@unique([tenantId, internalCode])
  @@index([tenantId])
  @@index([tenantId, createdById])
  @@index([tenantId, city])
  @@index([tenantId, province])
  @@index([tenantId, provinceId])
  @@index([tenantId, localityId])
  @@index([countryId])
  @@index([provinceId])
  @@index([localityId])
  @@index([neighborhoodId])
  @@index([tenantId, status])
  @@index([tenantId, sortOrder])
  @@index([tenantId, updatedAt])
}

model DevelopmentImage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  storageKey String
  url        String?
  altText    String?
  mimeType   String?
  fileSize   Int?

  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([developmentId, sortOrder])
}

model DevelopmentFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([developmentId, featureId])
  @@index([tenantId])
  @@index([developmentId])
  @@index([featureId])
}

model DevelopmentTypology {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  developmentId String
  development   Development @relation(fields: [developmentId], references: [id], onDelete: Cascade)

  name           String
  description    String    @db.Text
  totalCount     Int?
  availableCount Int?
  surfaceFrom    Decimal?  @db.Decimal(10, 2)
  surfaceTo      Decimal?  @db.Decimal(10, 2)
  priceFrom      Decimal?  @db.Decimal(14, 2)
  currency       Currency?
  sortOrder      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  featureAssignments DevelopmentTypologyFeatureAssignment[]

  @@index([tenantId])
  @@index([developmentId, sortOrder])
}

model DevelopmentTypologyFeatureAssignment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  typologyId String
  typology   DevelopmentTypology @relation(fields: [typologyId], references: [id], onDelete: Cascade)

  featureId String
  feature   PropertyFeature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  value String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([typologyId, featureId])
  @@index([tenantId])
  @@index([typologyId])
  @@index([featureId])
}

/// Traceability for external imports (e.g. WordPress/Houzez).
/// entityId is NOT a polymorphic FK — PostgreSQL cannot enforce FKs across
/// Property | PropertyListing | PropertyPrice | PropertyImage | … via one column.
/// Referential integrity is application-owned; cascade deletes only apply to Tenant.
model MigrationSourceRef {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Logical entity kind, e.g. property | property_listing | property_price | property_image | property_feature_assignment | batch_manifest
  entityType String

  /// Target row id (cuid) in the corresponding table — not FK-enforced
  entityId String

  sourceSystem String
  sourceId     String

  migrationBatchId String

  /// Free-form migration metadata (oldSlug, oldUrl, rulesApplied, createdEntityIds, …)
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sourceSystem, sourceId, entityType])
  @@index([migrationBatchId])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, sourceSystem, migrationBatchId])
}

enum ContactPointType {
  EMAIL
  PHONE
}

enum ContactDocumentType {
  DNI
  CUIT
  CUIL
  PASSPORT
}

enum RentalConceptSystemCode {
  RENT
  EXPENSES
  ELECTRICITY
  GAS
  ABL
  AYSA
  INSURANCE
}

enum RentalContractStatus {
  DRAFT
  ACTIVE
  ENDED
  CANCELLED
}

enum RentalObligationKind {
  RECURRING
  ONE_TIME
}

enum RentalAmountMode {
  FIXED
  VARIABLE
}

enum RentalDueMode {
  FIXED_DAY
  MANUAL_PER_PERIOD
}

enum RentalOccurrenceStatus {
  PENDING
  FULFILLED
  CANCELLED
}

enum RentalFulfillmentStatus {
  RECORDED
  REVERSED
}

enum RentalFulfillmentOrigin {
  ADMIN
}

enum RentalContractPartyRole {
  RENTER
  LANDLORD
}

enum RentalContractEventType {
  ACTIVATED
  ENDED
  CANCELLED
  PARTIES_CHANGED
  RENT_VALUE_REVISED
  RENEWED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum RentalReminderEventType {
  PRE_DUE
  DUE
  POST_DUE
}

enum RentalReminderDispatchStatus {
  PLANNED
  READY
  PROCESSING
  COMPLETED
  PARTIALLY_COMPLETED
  FAILED
  SKIPPED
}

enum RentalReminderDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

enum RentalReminderAttemptStatus {
  PROCESSING
  ACCEPTED
  FAILED
}

enum RentalReminderStatusSource {
  INTERNAL
  PROVIDER_RESPONSE
  PROVIDER_WEBHOOK
}

enum RentalReminderPlanningIssueType {
  DUE_DATE_MISSING
  DISPLAY_AMOUNT_MISSING
  NO_ENABLED_ROUTE
  CONTACT_POINT_INELIGIBLE
  TENANT_TIME_ZONE_MISSING_OR_INVALID
  PROVIDER_CONFIGURATION_INVALID
  PROVIDER_TEMPLATE_INVALID
  PLANNING_WINDOW_EXPIRED
}

enum RentalReminderPlanningIssueStatus {
  OPEN
  RESOLVED
}

enum RentalReminderDispatchOccurrenceStatus {
  INCLUDED
  EXCLUDED_BEFORE_SEND
}

enum RentalReminderWebhookReceiptStatus {
  RECEIVED
  APPLIED
  IGNORED
}

model Contact {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name           String
  documentType   ContactDocumentType?
  documentNumber String?
  notes          String?              @db.Text
  isActive       Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contactPoints         ContactPoint[]
  rentalContractParties RentalContractParty[]
  inboundMessages       CommunicationInboundMessage[]

  @@unique([tenantId, id])
  @@index([tenantId, name])
  @@index([tenantId, isActive])
  @@index([tenantId, documentNumber])
}

model ContactPoint {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  type            ContactPointType
  value           String
  normalizedValue String
  label           String?

  isDefault          Boolean @default(false)
  isActive           Boolean @default(true)
  canReceiveSms      Boolean @default(false)
  canReceiveWhatsapp Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalContractNotificationRoutes RentalContractNotificationRoute[]
  inboundMessages                  CommunicationInboundMessage[]

  @@unique([tenantId, id])
  @@index([tenantId, contactId])
  @@index([tenantId, type, normalizedValue])
  @@index([contactId, type, isDefault])
}

model RentalConcept {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name       String
  slug       String
  systemCode RentalConceptSystemCode?
  isActive   Boolean                  @default(true)
  sortOrder  Int                      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentalObligations RentalObligation[]

  @@unique([tenantId, slug])
  @@unique([tenantId, systemCode])
  @@index([tenantId, isActive])
  @@index([tenantId, sortOrder])
}

model RentalContract {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  propertyCountryId String?
  propertyCountry   Country? @relation("RentalContractCountry", fields: [propertyCountryId], references: [id], onDelete: SetNull)

  propertyProvinceId String?
  propertyProvince   Province? @relation("RentalContractProvince", fields: [propertyProvinceId], references: [id], onDelete: SetNull)

  propertyLocalityId String?
  propertyLocality   Locality? @relation("RentalContractLocality", fields: [propertyLocalityId], references: [id], onDelete: SetNull)

  propertyNeighborhoodId String?
  propertyNeighborhood   Neighborhood? @relation("RentalContractNeighborhood", fields: [propertyNeighborhoodId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("RentalContractCreator", fields: [createdById], references: [id], onDelete: SetNull)

  internalNumber String

  previousContractId String?
  previousContract   RentalContract? @relation("RentalContractRenewal", fields: [tenantId, previousContractId], references: [tenantId, id], onDelete: Restrict)
  renewedContract    RentalContract? @relation("RentalContractRenewal")

  propertyAddressSnapshot      String
  propertyCountrySnapshot      String?
  propertyProvinceSnapshot     String?
  propertyLocalitySnapshot     String?
  propertyNeighborhoodSnapshot String?
  propertyStreetSnapshot       String?
  propertyStreetNumberSnapshot String?
  propertyFloorSnapshot        String?
  propertyUnitSnapshot         String?
  propertyPostalCodeSnapshot   String?
  propertyNotesSnapshot        String? @db.Text

  startsOn DateTime             @db.Date
  endsOn   DateTime?            @db.Date
  status   RentalContractStatus @default(DRAFT)
  notes    String?              @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  obligations        RentalObligation[]
  parties            RentalContractParty[]
  events             RentalContractEvent[]
  reminderDispatches RentalReminderDispatch[]
  inboundMessages    CommunicationInboundMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, internalNumber])
  @@unique([tenantId, previousContractId])
  @@index([tenantId, status])
  @@index([tenantId, propertyId])
  @@index([propertyCountryId])
  @@index([propertyProvinceId])
  @@index([propertyLocalityId])
  @@index([propertyNeighborhoodId])
  @@index([tenantId, endsOn])
}

model RentalContractEvent {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractId String
  contract   RentalContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Cascade)

  type RentalContractEventType

  actorId String?
  actor   User?   @relation("RentalContractEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  occurredAt DateTime @default(now())
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, contractId, occurredAt(sort: Desc)])
  @@index([tenantId, contractId, type, occurredAt(sort: Desc)])
  @@index([actorId])
}

model RentalContractSequence {
  tenantId String @id
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model RentalContractParty {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Restrict)

  role      RentalContractPartyRole
  isPrimary Boolean                 @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notificationRoutes RentalContractNotificationRoute[]

  @@unique([contractId, contactId, role])
  @@index([tenantId, contractId, role])
  @@index([tenantId, contactId])
}

model RentalContractNotificationRoute {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractPartyId String
  contractParty   RentalContractParty @relation(fields: [contractPartyId], references: [id], onDelete: Cascade)

  channel NotificationChannel

  contactPointId String
  contactPoint   ContactPoint @relation(fields: [contactPointId], references: [id], onDelete: Restrict)

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([contractPartyId, channel])
  @@index([tenantId, contractPartyId])
  @@index([tenantId, contactPointId])
}

model RentalObligation {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractId String
  contract   RentalContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  conceptId String
  concept   RentalConcept @relation(fields: [conceptId], references: [id], onDelete: Restrict)

  kind                     RentalObligationKind
  recurrenceMonths         Int?
  dueMode                  RentalDueMode        @default(FIXED_DAY)
  dueDay                   Int?
  amountMode               RentalAmountMode
  defaultAmount            Decimal?             @db.Decimal(14, 2)
  currency                 Currency
  adjustmentIntervalMonths Int?
  includeInNotice          Boolean              @default(false)
  showAmount               Boolean              @default(false)
  startsOn                 DateTime             @db.Date
  endsOn                   DateTime?            @db.Date
  isActive                 Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences        RentalObligationOccurrence[]
  rentValueRevisions RentalRentValueRevision[]

  @@unique([tenantId, id])
  @@index([tenantId, contractId, isActive])
  @@index([tenantId, conceptId])
}

model RentalRentValueRevision {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  obligationId String
  obligation   RentalObligation @relation(fields: [tenantId, obligationId], references: [tenantId, id], onDelete: Cascade)

  effectiveFrom DateTime @db.Date
  amount        Decimal  @db.Decimal(14, 2)
  currency      Currency

  recordedById String?
  recordedBy   User?   @relation("RentalRentValueRevisionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  reason       String? @db.Text

  createdAt DateTime @default(now())

  @@unique([obligationId, effectiveFrom])
  @@index([tenantId, effectiveFrom])
  @@index([recordedById])
}

model RentalObligationOccurrence {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  obligationId String
  obligation   RentalObligation @relation(fields: [obligationId], references: [id], onDelete: Cascade)

  periodKey      String
  periodStartsOn DateTime?              @db.Date
  periodEndsOn   DateTime?              @db.Date
  dueDate        DateTime?              @db.Date
  amount         Decimal?               @db.Decimal(14, 2)
  currency       Currency
  status         RentalOccurrenceStatus @default(PENDING)

  cancelledAt        DateTime?
  cancelledById      String?
  cancelledBy        User?     @relation("RentalOccurrenceCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fulfillments       RentalFulfillment[]
  reminderDispatches RentalReminderDispatchOccurrence[]

  @@unique([tenantId, id])
  @@unique([obligationId, periodKey])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, obligationId, dueDate])
}

model RentalReminderPolicy {
  id String @id @default(cuid())

  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  preDueEnabled   Boolean @default(true)
  preDueDays      Int     @default(3)
  dueEnabled      Boolean @default(true)
  postDueEnabled  Boolean @default(true)
  postDueDays     Int     @default(3)
  sendTimeMinutes Int     @default(600)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RentalReminderPlanningIssue {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractId         String?
  occurrenceId       String?
  recipientContactId String?
  channel            NotificationChannel?
  type               RentalReminderPlanningIssueType
  deduplicationKey   String
  status             RentalReminderPlanningIssueStatus @default(OPEN)
  firstDetectedAt    DateTime                          @default(now())
  lastDetectedAt     DateTime                          @default(now())
  resolvedAt         DateTime?
  metadata           Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, deduplicationKey])
  @@index([tenantId, status, lastDetectedAt(sort: Desc)])
  @@index([tenantId, contractId])
  @@index([tenantId, occurrenceId])
}

model RentalReminderDispatch {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contractId String
  contract   RentalContract @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Cascade)

  recipientContactId   String?
  recipientIdentityKey String
  eventType            RentalReminderEventType
  dueDate              DateTime                     @db.Date
  scheduledFor         DateTime
  groupKey             String
  occurrenceSetHash    String
  status               RentalReminderDispatchStatus @default(PLANNED)
  skipReason           String?
  policySnapshot       Json
  recipientSnapshot    Json
  contentSnapshot      Json
  frozenAt             DateTime?
  firstAttemptAt       DateTime?
  completedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  occurrences RentalReminderDispatchOccurrence[]
  deliveries  RentalReminderDelivery[]

  @@unique([tenantId, id])
  @@unique([tenantId, groupKey])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, contractId, createdAt(sort: Desc)])
  @@index([tenantId, recipientContactId])
}

model RentalReminderDispatchOccurrence {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dispatchId String
  dispatch   RentalReminderDispatch @relation(fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: Cascade)

  occurrenceId String
  occurrence   RentalObligationOccurrence @relation(fields: [tenantId, occurrenceId], references: [tenantId, id], onDelete: Restrict)

  status          RentalReminderDispatchOccurrenceStatus @default(INCLUDED)
  exclusionReason String?
  evaluatedAt     DateTime                               @default(now())

  @@id([dispatchId, occurrenceId])
  @@index([tenantId, occurrenceId])
}

model RentalReminderDelivery {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  dispatchId String
  dispatch   RentalReminderDispatch @relation(fields: [tenantId, dispatchId], references: [tenantId, id], onDelete: Cascade)

  channel             NotificationChannel
  contactPointId      String?
  routeId             String?
  deliveryKey         String
  status              RentalReminderDeliveryStatus @default(PENDING)
  statusSource        RentalReminderStatusSource   @default(INTERNAL)
  destinationSnapshot String
  contentSnapshot     Json
  subjectSnapshot     String?                      @db.Text
  bodySnapshot        String                       @db.Text
  templateKey         String
  templateVersion     String
  providerKey         String
  providerAccountKey  String
  providerTemplateRef String?
  attemptCount        Int                          @default(0)
  nextAttemptAt       DateTime?
  processingToken     String?
  lockedUntil         DateTime?
  providerMessageId   String?
  sentAt              DateTime?
  deliveredAt         DateTime?
  readAt              DateTime?
  failedAt            DateTime?
  skippedAt           DateTime?
  errorCategory       String?
  errorCode           String?
  errorMessage        String?                      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts        RentalReminderDeliveryAttempt[]
  webhookReceipts RentalReminderWebhookReceipt[]
  inboundMessages CommunicationInboundMessage[]

  @@unique([tenantId, id])
  @@unique([tenantId, deliveryKey])
  @@unique([dispatchId, channel])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, dispatchId])
}

model RentalReminderDeliveryAttempt {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveryId String
  delivery   RentalReminderDelivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id], onDelete: Cascade)

  attemptNumber     Int
  attemptKey        String
  status            RentalReminderAttemptStatus @default(PROCESSING)
  startedAt         DateTime                    @default(now())
  finishedAt        DateTime?
  latencyMs         Int?
  providerMessageId String?
  errorCategory     String?
  errorCode         String?
  errorMessage      String?                     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  webhookReceipts RentalReminderWebhookReceipt[]

  @@unique([tenantId, id])
  @@unique([deliveryId, attemptNumber])
  @@unique([tenantId, attemptKey])
  @@index([tenantId, deliveryId, startedAt(sort: Desc)])
}

model RentalReminderWebhookReceipt {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveryId String
  delivery   RentalReminderDelivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id], onDelete: Cascade)

  attemptId          String?
  attempt            RentalReminderDeliveryAttempt?     @relation(fields: [tenantId, attemptId], references: [tenantId, id], onDelete: Restrict)
  providerKey        String
  providerAccountKey String
  providerEventKey   String
  providerMessageId  String?
  eventType          String
  providerOccurredAt DateTime?
  receivedAt         DateTime                           @default(now())
  processedAt        DateTime?
  status             RentalReminderWebhookReceiptStatus @default(RECEIVED)
  payloadDigest      String
  errorCategory      String?
  errorCode          String?
  errorMessage       String?                            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerKey, providerAccountKey, providerEventKey])
  @@index([tenantId, deliveryId, receivedAt(sort: Desc)])
  @@index([tenantId, attemptId])
  @@index([providerKey, providerAccountKey, providerMessageId])
}

model CommunicationInboundMessage {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  providerKey        String
  providerAccountKey String
  channel            NotificationChannel @default(WHATSAPP)
  providerMessageId  String
  senderAddress      String
  messageType        String
  body               String?             @db.Text
  metadata           Json?
  receivedAt         DateTime
  createdAt          DateTime            @default(now())

  contactPointId String?
  contactPoint   ContactPoint? @relation(fields: [tenantId, contactPointId], references: [tenantId, id], onDelete: Restrict)

  contactId String?
  contact   Contact? @relation(fields: [tenantId, contactId], references: [tenantId, id], onDelete: Restrict)

  contractId String?
  contract   RentalContract? @relation(fields: [tenantId, contractId], references: [tenantId, id], onDelete: Restrict)

  deliveryId String?
  delivery   RentalReminderDelivery? @relation(fields: [tenantId, deliveryId], references: [tenantId, id], onDelete: Restrict)

  @@unique([providerKey, providerAccountKey, providerMessageId])
  @@index([tenantId, receivedAt(sort: Desc)])
  @@index([tenantId, contactId, receivedAt(sort: Desc)])
  @@index([tenantId, contractId, receivedAt(sort: Desc)])
  @@index([tenantId, deliveryId])
}

model RentalFulfillment {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  occurrenceId String
  occurrence   RentalObligationOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  status      RentalFulfillmentStatus @default(RECORDED)
  fulfilledOn DateTime                @db.Date
  amount      Decimal?                @db.Decimal(14, 2)
  notes       String?                 @db.Text
  origin      RentalFulfillmentOrigin @default(ADMIN)

  recordedById   String?
  recordedBy     User?     @relation("RentalFulfillmentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  reversedAt     DateTime?
  reversedById   String?
  reversedBy     User?     @relation("RentalFulfillmentReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  reversalReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, occurrenceId, status])
  @@index([tenantId, fulfilledOn])
}
