# Explicit opt-in required by the development database safety wrapper.
NODE_ENV=development
VALORAR_DATABASE_ENV=development

# Use only an isolated development database/branch. Never commit credentials.
DATABASE_URL=

# Optional C3B development-only Meta configuration. Never commit values.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WHATSAPP_API_VERSION=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_DEVELOPMENT_ALLOWED_RECIPIENT=
